{
  "name": "bite-nutrition",
  "version": "1.0.0",
  "private": true,
  "description": "Nutrition website with React frontend and Express backend.",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --config frontend/vite.config.mjs\"",
    "server": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.mjs",
    "preview": "vite preview --config frontend/vite.config.mjs",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.1"
  }
}
